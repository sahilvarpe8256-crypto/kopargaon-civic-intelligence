{
  "name": "kopargaon-civic-intelligence-backend",
  "version": "1.0.0",
  "description": "Kopargaon Civic Intelligence Platform Backend, Priority Engine and AI Analysis Service",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/data/seed.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "kopargaon",
    "civic-intelligence",
    "express",
    "gemini",
    "priority-engine"
  ],
  "author": "Kopargaon Civic Intelligence Team",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}